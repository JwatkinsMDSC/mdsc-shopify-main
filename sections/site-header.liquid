{% schema %}
{
  "name": "Site Header",
  "settings": [
    {
      "type": "header",
      "content": "Top Bar"
    },
    {
      "type": "checkbox",
      "id": "enable_top_bar",
      "label": "Enable Top Bar",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_phone_number",
      "label": "Enable Phone Number",
      "default": true
    },
    {
      "type": "text",
      "id": "phone_number",
      "label": "Phone Number",
      "default": "(555) 555-1234"
    },
    {
      "type": "checkbox",
      "id": "enable_currency_selector",
      "label": "Enable Currency Selector",
      "default": true
    },
    {
      "type": "color",
      "id": "top_bar_bg_color",
      "label": "Background Color",
      "default": "#1e3a8a"
    },
    {
      "type": "header",
      "content": "Middle Bar"
    },
    {
      "type": "image_picker",
      "id": "logo_retail",
      "label": "Retail Logo"
    },
    {
      "type": "image_picker",
      "id": "logo_b2b",
      "label": "B2B Logo"
    },
    {
      "type": "range",
      "id": "logo_width",
      "min": 50,
      "max": 250,
      "step": 10,
      "default": 150,
      "unit": "px",
      "label": "Logo width"
    },
    {
      "type": "header",
      "content": "Main Nav Bar"
    },
    {
      "type": "checkbox",
      "id": "enable_main_nav",
      "label": "Enable Main Nav",
      "default": true
    },
    {
      "type": "link_list",
      "id": "main_menu",
      "label": "Main Menu",
      "default": "main-menu"
    }
  ],
  "blocks": [
    {
      "type": "announcement",
      "name": "Announcement",
      "settings": [
        {
          "type": "richtext",
          "id": "text",
          "label": "Text"
        },
        {
          "type": "text",
          "id": "link_text",
          "label": "Link text",
          "default": "Learn More"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Site Header"
    }
  ]
}
{% endschema %}

<header id="siteHeader" class="fixed top-0 left-0 right-0 z-50">
  {% if section.settings.enable_top_bar %}
    <div class="text-sm" style="background-color: {{ section.settings.top_bar_bg_color }};">
      <div class="relative max-w-400 mx-auto flex justify-end px-0 sm:px-4 py-0.5 sm:py-2 gap-4">
        {% assign announcement_blocks = section.blocks | where: 'type', 'announcement' %}
        {% if announcement_blocks.size > 0 %}
          <div class="banner-rotator flex text-primary-50 tracking-tight text-xs lg:text-sm w-full sm:w-100 md:w-100 lg:w-240 relative sm:absolute sm:left-30 md:left-1/2 top-1/2 translate-0 md:-translate-x-1/2 sm:-translate-y-1/2 justify-center">
            <button class="btn btn-clear btn-micro text-secondary-500 hover:text-secondary-300" data-banner-prev>
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" width="20" height="20" class="size-5">
                <path fill-rule="evenodd" d="M11.78 5.22a.75.75 0 0 1 0 1.06L8.06 10l3.72 3.72a.75.75 0 1 1-1.06 1.06l-4.25-4.25a.75.75 0 0 1 0-1.06l4.25-4.25a.75.75 0 0 1 1.06 0Z" />
              </svg>
            </button>
            <div class="relative text-center w-full sm:w-100">
              {% for block in announcement_blocks %}
                  <div class="banner-offer{% if forloop.first %} active{% else %} inactive{% endif %}" {{ block.shopify_attributes }}>
                    {{ block.settings.text }}
                    {% if block.settings.link != blank %}
                      <a href="{{ block.settings.link }}" class="font-semibold text-secondary-500 underline">
                        {{ block.settings.link_text | default: 'Learn More' }}
                      </a>
                    {% endif %}
                  </div>
              {% endfor %}
            </div>
            <button class="btn btn-clear btn-micro text-secondary-500 hover:text-secondary-300" data-banner-next>
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" width="20" height="20" class="size-5">
                <path fill-rule="evenodd" d="M8.22 5.22a.75.75 0 0 1 1.06 0l4.25 4.25a.75.75 0 0 1 0 1.06l-4.25 4.25a.75.75 0 1 1-1.06-1.06L11.94 10 8.22 6.28a.75.75 0 0 1 0-1.06Z" />
              </svg>
            </button>
          </div>
        {% endif %}

        <div class="hidden sm:flex items-center gap-0 md:gap-6">
          {% if section.settings.enable_phone_number and section.settings.phone_number != blank %}
            <div class="flex items-center gap-1">
              <span class="text-secondary-500">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" width="12" height="12" class="size-3 lg:size-4">
                  <path fill-rule="evenodd" d="M1.5 4.5a3 3 0 0 1 3-3h1.372c.86 0 1.61.586 1.819 1.42l1.105 4.423a1.875 1.875 0 0 1-.694 1.955l-1.293.97c-.135.101-.164.249-.126.352a11.285 11.285 0 0 0 6.697 6.697c.103.038.25.009.352-.126l.97-1.293a1.875 1.875 0 0 1 1.955-.694l4.423 1.105c.834.209 1.42.959 1.42 1.82V19.5a3 3 0 0 1-3 3h-2.25C8.552 22.5 1.5 15.448 1.5 6.75V4.5Z" clip-rule="evenodd" />
                </svg>
              </span>
              <span class="text-primary-50 text-xs lg:text-sm tracking-tight">{{ section.settings.phone_number }}</span>
            </div>
          {% endif %}

          {% if section.settings.enable_currency_selector and localization.available_countries.size > 1 %}
            <div class="relative">
              {% form 'localization', id: 'site-header-currency', class: 'hidden md:inline-flex items-center gap-x-1 text-xs lg:text-sm font-semibold text-gray-50 dark:text-white' %}
                <button type="button" popovertarget="site-header-currency-menu" class="flex items-center gap-x-1">
                  <span>{{ localization.country.currency.iso_code }} {{ localization.country.currency.symbol }}</span>
                  <svg viewBox="0 0 20 20" fill="currentColor" width="20" height="20" data-slot="icon" aria-hidden="true" class="size-5">
                    <path d="M5.22 8.22a.75.75 0 0 1 1.06 0L10 11.94l3.72-3.72a.75.75 0 1 1 1.06 1.06l-4.25 4.25a.75.75 0 0 1-1.06 0L5.22 9.28a.75.75 0 0 1 0-1.06Z" clip-rule="evenodd" fill-rule="evenodd" />
                  </svg>
                </button>
                <div id="site-header-currency-menu" popover class="w-56 p-1 shrink rounded-xl bg-white text-sm/6 font-semibold text-gray-900 shadow-lg outline-1 outline-gray-900/5 dark:bg-gray-800 dark:text-white dark:shadow-none dark:outline dark:-outline-offset-1 dark:outline-white/10">
                  <div class="max-h-56 overflow-y-auto overscroll-contain scrollbar-stable scrollbar-thin scrollbar-color scrollbar-thumb-primary-400 scrollbar-track-white rounded-xl">
                    <ul role="list" class="divide-y divide-gray-100 dark:divide-white/5">
                      {% for country in localization.available_countries %}
                        <li>
                          <button type="submit" name="country_code" value="{{ country.iso_code }}" class="block w-full text-left p-2 hover:bg-gray-50 dark:hover:bg-white/2.5{% if country.iso_code == localization.country.iso_code %} text-primary-600{% endif %}">
                            {{ country.name }} ({{ country.currency.iso_code }} {{ country.currency.symbol }})
                          </button>
                        </li>
                      {% endfor %}
                    </ul>
                  </div>
                </div>
              {% endform %}
            </div>
          {% endif %}
        </div>
      </div>
    </div>
  {% endif %}

  <div class="relative z-20 border-b border-gray-200 backdrop-blur-xl bg-secondary-800/80">
    <div class="relative max-w-400 mx-auto px-4 py-4 sm:py-6 flex items-center justify-between">
      <div class="absolute flex items-center">
        <a href="{{ routes.root_url }}">
          {% assign is_b2b = false %}
          {% if customer and customer.tags contains 'b2b' %}
            {% assign is_b2b = true %}
          {% endif %}

          {% assign logo_image = section.settings.logo_retail %}
          {% if is_b2b and section.settings.logo_b2b != blank %}
            {% assign logo_image = section.settings.logo_b2b %}
          {% endif %}

          {% if logo_image != blank %}
            {{ logo_image | image_url: width: 600 | image_tag: class: 'h-28 -translate-x-2 md:translate-x-0 sm:h-34 md:h-36 translate-y-4 md:translate-y-2 drop-shadow-xl drop-shadow-primary-700/40', width: section.settings.logo_width, alt: shop.name }}
          {% else %}
            <span class="h-28 flex items-center text-2xl font-bold text-white">{{ shop.name }}</span>
          {% endif %}
        </a>
      </div>

      <div class="hidden sm:block flex-1 w-full sm:w-72 md:w-100 lg:w-140 absolute left-1/2 top-1/2 -translate-x-44 md:-translate-x-1/2 -translate-y-1/2">
        <form action="{{ routes.search_url }}" method="get" class="flex bg-white rounded-md overflow-hidden">
          <input type="text" name="q" class="flex-1 px-4 py-2 text-sm focus:outline-hidden" placeholder="What can we help you find today?" />
          <button type="submit" class="bg-secondary-600 px-4 text-white">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" width="24" height="24" class="size-6">
              <path fill-rule="evenodd" d="M10.5 3.75a6.75 6.75 0 1 0 0 13.5 6.75 6.75 0 0 0 0-13.5ZM2.25 10.5a8.25 8.25 0 1 1 14.59 5.28l4.69 4.69a.75.75 0 1 1-1.06 1.06l-4.69-4.69A8.25 8.25 0 0 1 2.25 10.5Z" clip-rule="evenodd" />
            </svg>
          </button>
        </form>
      </div>

      <div class="flex items-center gap-4 ml-auto">
        <div class="flow-root">
          <button data-cart-trigger class="group -m-2 flex items-center p-2 text-gray-50">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="24" height="24" class="size-6 shrink-0 text-gray-50 group-hover:text-primary-50">
              <path d="M2.25 3h1.386c.51 0 .955.343 1.087.835l.383 1.437M7.5 14.25a3 3 0 0 0-3 3h15.75m-12.75-3h11.218c1.121-2.3 2.1-4.684 2.924-7.138a60.114 60.114 0 0 0-16.536-1.84M7.5 14.25 5.106 5.272M6 20.25a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0Zm12.75 0a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0Z" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
            <span class="ml-2 text-sm font-medium text-gray-50 group-hover:text-primary-100" data-cart-count>{{ cart.item_count }}</span>
          </button>
        </div>

        <a href="{{ routes.account_url }}" class="flex items-center gap-1 text-sm text-gray-50 cursor-pointer hover:text-primary-100">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="24" height="24" class="size-6 shrink-0">
            <path d="M15.75 6a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0ZM4.501 20.118a7.5 7.5 0 0 1 14.998 0A17.933 17.933 0 0 1 12 21.75c-2.676 0-5.216-.584-7.499-1.632Z" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
          <span>Account</span>
        </a>

        <div class="flex items-center md:hidden">
          <button type="button" data-mobile-menu-toggle class="text-white p-0" aria-expanded="false">
            <span class="sr-only">Open main menu</span>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="24" height="24" class="size-6" data-menu-closed>
              <path d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="24" height="24" class="size-6 hidden" data-menu-open>
              <path d="M6 18 18 6M6 6l12 12" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
          </button>
        </div>
      </div>
    </div>
  </div>

  {% if section.settings.enable_main_nav %}
    <nav class="pl-40 lg:pl-0 z-10 bg-white shadow-sm border-b border-gray-200">
      <div class="flex justify-start lg:justify-center max-w-400 mx-auto min-h-9 text-sm font-medium text-gray-900">
        <div class="flex gap-6 whitespace-nowrap overflow-x-auto items-center scrollbar scrollbar-thumb-primary-300 scrollbar-track-white scrollbar-h-1">
          {% for link in linklists[section.settings.main_menu].links %}
            <a href="{{ link.url }}" class="hover:text-primary-600">{{ link.title }}</a>
          {% endfor %}
        </div>
      </div>
    </nav>
  {% endif %}

  {% render 'site-header-filters' %}

  <!-- Mobile Menu Container -->
  <div id="mobile-menu" class="fixed inset-0 z-40 bg-white transform transition-transform duration-300 ease-in-out translate-x-full md:hidden" data-mobile-menu>
    <div class="flex flex-col h-full">
      <div class="flex items-center justify-between p-4 border-b border-gray-200">
        <span class="text-lg font-bold">Menu</span>
        <button type="button" class="p-2 -mr-2 text-gray-500" data-mobile-menu-close>
          <span class="sr-only">Close menu</span>
          <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
      <div class="flex-1 overflow-y-auto py-4">
        <nav class="px-4 space-y-2">
          {% for link in linklists[section.settings.main_menu].links %}
            <a href="{{ link.url }}" class="block py-2 text-base font-medium text-gray-900 hover:text-primary-600">
              {{ link.title }}
            </a>
          {% endfor %}
        </nav>
      </div>
      {% if section.settings.enable_phone_number and section.settings.phone_number != blank %}
        <div class="p-4 border-t border-gray-200">
          <a href="tel:{{ section.settings.phone_number }}" class="flex items-center gap-2 text-primary-600">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-5 h-5">
              <path fill-rule="evenodd" d="M1.5 4.5a3 3 0 0 1 3-3h1.372c.86 0 1.61.586 1.819 1.42l1.105 4.423a1.875 1.875 0 0 1-.694 1.955l-1.293.97c-.135.101-.164.249-.126.352a11.285 11.285 0 0 0 6.697 6.697c.103.038.25.009.352-.126l.97-1.293a1.875 1.875 0 0 1 1.955-.694l4.423 1.105c.834.209 1.42.959 1.42 1.82V19.5a3 3 0 0 1-3 3h-2.25C8.552 22.5 1.5 15.448 1.5 6.75V4.5Z" clip-rule="evenodd" />
            </svg>
            {{ section.settings.phone_number }}
          </a>
        </div>
      {% endif %}
    </div>
  </div>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const mobileMenu = document.querySelector('[data-mobile-menu]');
      const toggleBtns = document.querySelectorAll('[data-mobile-menu-toggle]');
      const closeBtn = document.querySelector('[data-mobile-menu-close]');
      
      if (!mobileMenu) return;

      function openMenu() {
        mobileMenu.classList.remove('translate-x-full');
        document.body.style.overflow = 'hidden';
      }

      function closeMenu() {
        mobileMenu.classList.add('translate-x-full');
        document.body.style.overflow = '';
      }

      toggleBtns.forEach(btn => btn.addEventListener('click', openMenu));
      if (closeBtn) closeBtn.addEventListener('click', closeMenu);
    });
  </script>
</header>
