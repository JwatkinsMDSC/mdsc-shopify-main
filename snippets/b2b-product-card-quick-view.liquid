{% comment %}
  Renders the quick view modal structure
  The content will be populated by JavaScript when a product is clicked
  
  Usage:
  {% render 'b2b-product-card-quick-view' %}
{% endcomment %}

<el-dialog>
  <dialog id="b2bQuickViewModal" class="relative z-10 backdrop:bg-transparent" data-quick-view-modal>
    <el-dialog-backdrop class="modal-backdrop backdrop-blur"></el-dialog-backdrop>

    <div tabindex="0" class="fixed inset-0 z-10 w-screen overflow-y-auto focus:outline-hidden">
      <div class="flex min-h-full items-stretch justify-center text-center md:items-center md:px-2 lg:px-4">
        <span aria-hidden="true" class="hidden md:inline-block md:h-screen md:align-middle">&#8203;</span>
        
        <el-dialog-panel class="flex w-full transform text-left text-base transition data-closed:translate-y-4 data-closed:opacity-0 data-enter:duration-300 data-enter:ease-out data-leave:duration-200 data-leave:ease-in md:my-8 md:max-w-2xl md:px-4 data-closed:md:translate-y-0 data-closed:md:scale-95 lg:max-w-7xl">
            <div class="relative flex flex-col w-full bg-white shadow-2xl rounded-lg overflow-hidden">
                <!-- Close Button -->
                <button type="button" command="close" commandfor="b2bQuickViewModal"
                    class="absolute top-4 right-4 z-40 bg-white rounded-full border p-2 border-gray-200 text-gray-400 hover:text-gray-500 shadow">
                    <span class="sr-only">Close</span>
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="size-6">
                        <path d="M6 18L18 6M6 6l12 12" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                </button>

                <div class="absolute inset-0 flex items-center justify-center bg-white z-20 hidden" data-quick-view-spinner>
                    <span class="loading loading-spinner loading-sm text-primary"></span>
                </div>

                <!-- Product Layout -->
                <div class="flex flex-col lg:flex-row items-stretch bg-white text-black" data-quick-view-content>
                    <!-- Left: Product Image -->
                    <div class="w-full lg:w-1/2 flex">
                        <!-- Swiper -->
                        <div class="relative swiper h-full w-full" data-quick-view-gallery data-swiper data-swiper-config='{"navigation":{"nextEl":".btn-next","prevEl":".btn-prev"},"pagination":{"el":".quickview-gallery-pagination","clickable":true}}'>
                            <div class="swiper-wrapper h-full" data-swiper-wrapper>
                                <!-- Slides will be injected here -->
                            </div>
                            <div class="swiper-hero-btn btn-prev">
                                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="size-5">
                                    <path fill-rule="evenodd"
                                        d="M11.78 5.22a.75.75 0 0 1 0 1.06L8.06 10l3.72 3.72a.75.75 0 1 1-1.06 1.06l-4.25-4.25a.75.75 0 0 1 0-1.06l4.25-4.25a.75.75 0 0 1 1.06 0Z"
                                        clip-rule="evenodd" />
                                </svg>
                            </div>
                            <div class="swiper-hero-btn btn-next">
                                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="size-5">
                                    <path fill-rule="evenodd"
                                        d="M8.22 5.22a.75.75 0 0 1 1.06 0l4.25 4.25a.75.75 0 0 1 0 1.06l-4.25 4.25a.75.75 0 0 1-1.06-1.06L11.94 10 8.22 6.28a.75.75 0 0 1 0-1.06Z"
                                        clip-rule="evenodd" />
                                </svg>
                            </div>
                            <div class="quickview-gallery-pagination-wrapper">
                                <div class="quickview-gallery-pagination flex"></div>
                            </div>
                        </div>
                    </div>

                    <!-- Right: Product Info -->
                    <div class="w-full p-6 sm:p-8 md:p-10 lg:w-1/2 space-y-6">
                        <!-- Brand & Name -->
                        <div>
                            <p class="text-sm text-gray-500" data-quick-view-vendor>Marine Detail Supply Co.</p>
                            <h1 class="text-3xl font-medium tracking-tight" data-quick-view-title></h1>
                        </div>

                        <!-- Price & Reviews -->
                        <div class="flex items-center gap-3">
                            <p class="text-xl font-semibold leading-none" data-quick-view-price-display></p>
                            <div data-quick-view-reviews>
                                <!-- Reviews placeholder -->
                            </div>
                        </div>

                        <!-- Description -->
                        <div class="text-gray-800 line-clamp-4" data-quick-view-description>
                        </div>

                        <form data-quick-view-form>
                            <!-- Color Selection -->
                            <div class="product-card-variants scrollbar scrollbar-thumb-primary-600 scrollbar-track-gray-200 
                                    scrollbar-h-2 scrollbar-thumb-rounded-full scrollbar-track-rounded-full cursor-grab 
                                    active:cursor-grabbing select-none" data-variant-scroll data-quick-view-variant-selector>
                                <!-- Variants injected here -->
                            </div>

                            <!-- Stock Warning -->
                            <div data-quick-view-stock>
                                <!-- Stock warning injected here -->
                            </div>

                            <!-- Price + Qty + Add to Cart -->
                            <div class="product-card-price-area mt-6">

                                <!-- Price + Qty -->
                                <div class="flex w-full justify-between items-center gap-2">

                                    <!-- Price -->
                                    <div class="product-card-price-wrap">
                                        <p class="product-card-price-compare" data-quick-view-compare-price></p>
                                        <p class="product-card-price" data-quick-view-price></p>
                                    </div>

                                    <!-- Qty -->
                                    <div class="product-card-qty-wrap">
                                        <span class="product-card-qty">

                                            <button type="button" class="product-card-qty-btn product-card-qty-btn--left" data-qty-decrease>
                                                <span class="sr-only">Decrease</span>
                                                <svg viewBox="0 0 24 24" fill="currentColor" class="size-3">
                                                    <path fill-rule="evenodd"
                                                        d="M4.25 12a.75.75 0 0 1 .75-.75h14a.75.75 0 0 1 0 1.5H5a.75.75 0 0 1-.75-.75Z"
                                                        clip-rule="evenodd" />
                                                </svg>
                                            </button>

                                            <input type="number" value="1" min="1" class="input-qty" data-quick-view-quantity>

                                            <button type="button" class="product-card-qty-btn product-card-qty-btn--right" data-qty-increase>
                                                <span class="sr-only">Increase</span>
                                                <svg viewBox="0 0 24 24" fill="currentColor" class="size-3">
                                                    <path fill-rule="evenodd"
                                                        d="M12 3.75a.75.75 0 0 1 .75.75v6.75h6.75a.75.75 0 0 1 0 1.5h-6.75v6.75a.75.75 0 0 1-1.5 0v-6.75H4.5a.75.75 0 0 1 0-1.5h6.75V4.5a.75.75 0 0 1 .75-.75Z"
                                                        clip-rule="evenodd" />
                                                </svg>
                                            </button>

                                        </span>
                                    </div>

                                </div>

                                <!-- Add to Cart -->
                                <button type="submit" class="product-card-add">
                                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5"
                                        stroke="currentColor" class="size-5">
                                        <path stroke-linecap="round" stroke-linejoin="round"
                                            d="M2.25 3h1.386c.51 0 .955.343 1.087.835l.383 1.437M7.5 14.25a3 3 0 0 0-3 3h15.75m-12.75-3h11.218c1.121-2.3 2.1-4.684 2.924-7.138a60.114 60.114 0 0 0-16.536-1.84M7.5 14.25 5.106 5.272M6 20.25a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0Zm12.75 0a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0Z" />
                                    </svg>
                                    Add to cart
                                </button>

                            </div>
                        </form>

                        <!-- Local Pickup Available -->
                        <div class="border-l-4 border-green-800 bg-green-50 p-4" data-quick-view-pickup>
                            <div class="flex">
                                <div class="shrink-0">
                                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5"
                                        stroke="currentColor" class="size-6 text-green-900">
                                        <path stroke-linecap="round" stroke-linejoin="round"
                                            d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
                                        <path stroke-linecap="round" stroke-linejoin="round"
                                            d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z" />
                                    </svg>

                                </div>
                                <div class="ml-3">
                                    <div class="grid gap-1">
                                        <p class="text-sm font-medium leading-tight">Pickup available at Fort Myers, FL - Marine
                                            Detail Supply Co HQ</p>
                                        <small class="text-xs leading-tight">Usually ready in 1 hour</small>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- View Full Details -->
                        <div>
                            <a href="#" class="flex items-center gap-2 text-sm font-medium text-gray-700 hover:text-black transition" data-quick-view-link>
                                View full details
                                <span class="text-xl">→</span>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </el-dialog-panel>
      </div>
    </div>
  </dialog>
</el-dialog>