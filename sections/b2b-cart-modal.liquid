{% schema %}
{
  "name": "B2B Cart Modal",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shopping Cart"
    },
    {
      "type": "text",
      "id": "empty_cart_message",
      "label": "Empty Cart Message",
      "default": "Your cart is empty"
    }
  ]
}
{% endschema %}

<el-dialog>
  <dialog id="b2bCartModal" class="modal" data-cart-modal>
    <el-dialog-backdrop class="modal-backdrop backdrop-blur"></el-dialog-backdrop>
    
    <div tabindex="0" class="flex min-h-full items-stretch justify-center text-center focus:outline-none sm:items-center sm:px-6 lg:px-8">
      <el-dialog-panel class="modal-panel">
        
        <form class="relative flex w-full flex-col overflow-hidden bg-white pt-6 sm:rounded-lg">
          
          <div class="flex items-center justify-between px-4 sm:px-6 lg:px-8">
            <h2 class="text-lg font-medium text-gray-900">{{ section.settings.heading }}</h2>
            <button type="button" command="close" commandfor="b2bCartModal" class="text-gray-400 hover:text-gray-500" data-cart-close>
              <span class="sr-only">Close</span>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="24" height="24" data-slot="icon" aria-hidden="true" class="size-6">
                <path d="M6 18 18 6M6 6l12 12" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </button>
          </div>
          
          <section aria-labelledby="cart-heading">
            <h2 id="cart-heading" class="sr-only">Items in your shopping cart</h2>
            
            <div id="cartEmpty" class="text-center py-12 hidden px-4 sm:px-8">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="mx-auto size-12 text-gray-400">
                <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 3h1.386c.51 0 .955.343 1.087.835l.383 1.437M7.5 14.25a3 3 0 0 0-3 3h15.75m-12.75-3h11.218c1.121-2.3 2.1-4.684 2.924-7.138a60.114 60.114 0 0 0-16.536-1.84M7.5 14.25 5.106 5.272M6 20.25a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0Zm12.75 0a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0Z" />
              </svg>
              <p class="mt-4 text-sm text-gray-500">{{ section.settings.empty_cart_message }}</p>
            </div>
            
            <ul role="list" class="divide-y divide-gray-200 px-4 sm:px-8" id="cartItems">
            </ul>
            
          </section>
          
          <section aria-labelledby="summary-heading" class="mt-auto">
            <div class="">
              <h2 id="summary-heading" class="sr-only">Order summary</h2>
              
              <div class="border-t border-gray-200 px-4 py-6 sm:px-8">
                <div class="flex justify-between text-base font-medium text-gray-900">
                  <p>Subtotal</p>
                  <p id="cartSubtotal">$0.00</p>
                </div>
                <p class="mt-0.5 text-sm text-gray-500">Shipping and taxes calculated at checkout.</p>
                <div class="mt-6">
                  <a href="/checkout" class="btn btn-lg btn-primary btn-icon-trailing w-full">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" width="24" height="24" class="size-6">
                      <path d="M2.25 2.25a.75.75 0 0 0 0 1.5h1.386c.17 0 .318.114.362.278l2.558 9.592a3.752 3.752 0 0 0-2.806 3.63c0 .414.336.75.75.75h15.75a.75.75 0 0 0 0-1.5H5.378A2.25 2.25 0 0 1 7.5 15h11.218a.75.75 0 0 0 .674-.421 60.358 60.358 0 0 0 2.96-7.228.75.75 0 0 0-.525-.965A60.864 60.864 0 0 0 5.68 4.509l-.232-.867A1.875 1.875 0 0 0 3.636 2.25H2.25ZM3.75 20.25a1.5 1.5 0 1 1 3 0 1.5 1.5 0 0 1-3 0ZM16.5 20.25a1.5 1.5 0 1 1 3 0 1.5 1.5 0 0 1-3 0Z" />
                    </svg>
                    Checkout
                  </a>
                </div>
                <div class="mt-3 flex gap-3 justify-center text-center text-sm">
                  <span>or</span>
                  <button type="button" command="close" commandfor="b2bCartModal" class="btn btn-sm btn-clear p-0" aria-expanded="true" data-cart-close>
                    Continue Shopping
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" width="16" height="16" class="size-4">
                      <path fill-rule="evenodd" d="M16.72 7.72a.75.75 0 0 1 1.06 0l3.75 3.75a.75.75 0 0 1 0 1.06l-3.75 3.75a.75.75 0 1 1-1.06-1.06l2.47-2.47H3a.75.75 0 0 1 0-1.5h16.19l-2.47-2.47a.75.75 0 0 1 0-1.06Z" clip-rule="evenodd" />
                    </svg>
                  </button>
                </div>
              </div>
            </div>
          </section>
          
        </form>
        
      </el-dialog-panel>
    </div>
  </dialog>
</el-dialog>

{% raw %}
<script type="text/template" id="cart-item-template">
  <li class="relative flex gap-4 sm:gap-6 py-8 text-sm items-start sm:items-center">
    <button type="button" class="btn btn-micro badge-danger btn-circle shadow-md absolute -left-1.5 top-6" data-cart-remove="{{key}}">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="currentColor" width="12" height="12" class="size-3">
        <path d="M5.28 4.22a.75.75 0 0 0-1.06 1.06L6.94 8l-2.72 2.72a.75.75 0 1 0 1.06 1.06L8 9.06l2.72 2.72a.75.75 0 1 0 1.06-1.06L9.06 8l2.72-2.72a.75.75 0 0 0-1.06-1.06L8 6.94 5.28 4.22Z" />
      </svg>
    </button>
    <img src="{{image}}" alt="{{title}}" class="size-30 flex-none rounded-lg border border-gray-200 sm:size-32" />
    <div class="flex flex-col gap-4 sm:gap-0 sm:flex-row grow w-full items-start">
      <div class="flex flex-col grow flex-1">
        <h5 class="font-medium text-primary-900 tracking-tight">
          <a href="{{url}}">{{title}}</a>
        </h5>
        <p class="mt-1 text-gray-800">{{variant_title}}</p>
      </div>
      
      <div class="flex gap-4 sm:gap-0 sm:w-50 items-center">
        <div class="flex flex-col w-full items-start sm:items-center">
          <div class="product-card-qty-wrap">
            <span class="product-card-qty">
              <button type="button" class="product-card-qty-btn product-card-qty-btn--left" data-cart-decrease="{{key}}">
                <span class="sr-only">Decrease</span>
                <svg viewBox="0 0 24 24" fill="currentColor" width="12" height="12" class="size-3">
                  <path fill-rule="evenodd" d="M4.25 12a.75.75 0 0 1 .75-.75h14a.75.75 0 0 1 0 1.5H5a.75.75 0 0 1-.75-.75Z" clip-rule="evenodd" />
                </svg>
              </button>
              <input type="number" value="{{quantity}}" min="1" class="input-qty" data-cart-qty-input="{{key}}" readonly />
              <button type="button" class="product-card-qty-btn product-card-qty-btn--right" data-cart-increase="{{key}}">
                <span class="sr-only">Increase</span>
                <svg viewBox="0 0 24 24" fill="currentColor" width="12" height="12" class="size-3">
                  <path fill-rule="evenodd" d="M12 3.75a.75.75 0 0 1 .75.75v6.75h6.75a.75.75 0 0 1 0 1.5h-6.75v6.75a.75.75 0 0 1-1.5 0v-6.75H4.5a.75.75 0 0 1 0-1.5h6.75V4.5a.75.75 0 0 1 .75-.75Z" clip-rule="evenodd" />
                </svg>
              </button>
            </span>
          </div>
        </div>
        <div class="product-card-price-wrap">
          <p class="product-card-price-compare">{{original_line_price}}</p>
          <p class="product-card-price">{{line_price}}</p>
        </div>
      </div>
    </div>
  </li>
</script>
{% endraw %}
