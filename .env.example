# Marine Detail Supply Theme - Environment Variables

# Shopify Store Configuration
SHOPIFY_STORE_URL=your-store.myshopify.com
SHOPIFY_CLI_THEME_ID=

# Environment
MDS_ENV=development

# Development Server
VITE_PORT=3000
VITE_HOST=localhost

# Shopify API (if needed for custom integrations)
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_ACCESS_TOKEN=

# Store Configuration
STORE_NAME=development
STORE_LOCALE=en
STORE_CURRENCY=USD
STORE_TIMEZONE=America/New_York

# Feature Flags
ENABLE_DEBUG=true
ENABLE_ANALYTICS=false
ENABLE_HOT_RELOAD=true

# Build Configuration
NODE_ENV=development
BUILD_TARGET=modern

# Optional: Third-party integrations
# GOOGLE_ANALYTICS_ID=
# FACEBOOK_PIXEL_ID=
# KLAVIYO_API_KEY=

# Docker Configuration
DOCKER_HOST_PORT=3000
DOCKER_VITE_PORT=5173
DOCKER_SHOPIFY_PORT=9292
USER_ID=1000
GROUP_ID=1000
