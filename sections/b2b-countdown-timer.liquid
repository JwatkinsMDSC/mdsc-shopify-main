{% schema %}
{
  "name": "B2B Countdown Timer",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Limited Time Offer"
    },
    {
      "type": "text",
      "id": "end_date",
      "label": "End Date (YYYY-MM-DD)",
      "info": "Format: 2024-12-31"
    },
    {
      "type": "text",
      "id": "end_time",
      "label": "End Time (HH:MM)",
      "info": "Format: 23:59 (24-hour format)",
      "default": "23:59"
    },
    {
      "type": "checkbox",
      "id": "show_timer",
      "label": "Show Timer",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "B2B Countdown Timer"
    }
  ]
}
{% endschema %}

{% if section.settings.show_timer and section.settings.end_date != blank %}
  {% liquid
    assign end_datetime = section.settings.end_date | append: ' ' | append: section.settings.end_time
  %}
  
  <div class="bg-primary-700 text-white py-3" data-countdown-timer data-end-date="{{ end_datetime }}" id="countdownTimer">
    <div class="max-w-400 mx-auto px-4">
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        
        {% if section.settings.heading != blank %}
          <div class="text-sm sm:text-base font-semibold uppercase tracking-wide">
            {{ section.settings.heading }}
          </div>
        {% endif %}
        
        <div class="flex items-center gap-2 sm:gap-4">
          <div class="text-center">
            <div class="text-2xl sm:text-3xl font-bold" data-countdown-days>00</div>
            <div class="text-xs uppercase text-primary-200">Days</div>
          </div>
          <div class="text-2xl">:</div>
          <div class="text-center">
            <div class="text-2xl sm:text-3xl font-bold" data-countdown-hours>00</div>
            <div class="text-xs uppercase text-primary-200">Hours</div>
          </div>
          <div class="text-2xl">:</div>
          <div class="text-center">
            <div class="text-2xl sm:text-3xl font-bold" data-countdown-minutes>00</div>
            <div class="text-xs uppercase text-primary-200">Minutes</div>
          </div>
          <div class="text-2xl">:</div>
          <div class="text-center">
            <div class="text-2xl sm:text-3xl font-bold" data-countdown-seconds>00</div>
            <div class="text-xs uppercase text-primary-200">Seconds</div>
          </div>
        </div>
        
      </div>
    </div>
  </div>
{% endif %}

{% stylesheet %}
  [data-countdown-timer].expired {
    display: none;
  }
{% endstylesheet %}
