{% schema %}
{
  "name": "B2B Hero",
  "settings": [
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background Image"
    },
    {
      "type": "video",
      "id": "background_video",
      "label": "Background Video"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "Welcome to Marine Detail Supply"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Marine Detailing Products"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "The new arrivals have, well, newly arrived. Check out the latest options from our summer small-batch release while they're still in stock."
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "Shop Collection"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Collection",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "image_picker",
          "id": "custom_image",
          "label": "Custom Image (optional)"
        },
        {
          "type": "text",
          "id": "eyebrow",
          "label": "Eyebrow Text",
          "default": "Shop the collection"
        }
      ]
    },
    {
      "type": "custom_slide",
      "name": "Custom Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "eyebrow",
          "label": "Eyebrow Text",
          "default": "Shop the collection"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "text",
          "id": "button_text",
          "label": "Button Text",
          "default": "View Products"
        }
      ]
    }
  ],
  "max_blocks": 10,
  "presets": [
    {
      "name": "B2B Hero",
      "blocks": []
    }
  ]
}
{% endschema %}

<div class="relative">
  {% assign hero_default_video = 'video/waves-hexagon.mp4' | asset_url %}
  {% assign hero_button_link = section.settings.button_link | default: '/collections/all' %}

  <div aria-hidden="true" class="absolute inset-0 hidden sm:flex sm:flex-col">
    <div class="relative w-full flex-1 bg-primary-800">
      <div class="absolute inset-0 overflow-hidden">
        {% if section.settings.background_video != blank %}
          <video autoplay muted loop playsinline preload="auto" class="absolute top-1/2 left-1/2 min-w-full min-h-full -translate-x-1/2 -translate-y-1/2 object-cover">
            <source src="{{ section.settings.background_video }}" type="video/mp4" />
          </video>
        {% elsif section.settings.background_image != blank %}
          {{ section.settings.background_image | image_url: width: 1920 | image_tag: class: 'absolute top-1/2 left-1/2 min-w-full min-h-full -translate-x-1/2 -translate-y-1/2 object-cover' }}
        {% else %}
          <video autoplay muted loop playsinline preload="auto" class="absolute top-1/2 left-1/2 min-w-full min-h-full -translate-x-1/2 -translate-y-1/2 object-cover">
            <source src="{{ hero_default_video }}" type="video/mp4" />
          </video>
        {% endif %}
      </div>
      <div class="absolute inset-0 bg-primary-700 opacity-70"></div>
    </div>
    <div class="h-32 w-full md:h-40 lg:h-48"></div>
  </div>

  <div class="relative mx-auto max-w-4xl px-4 pb-54 pt-42 sm:pb-0 sm:mb-16 md:mb-22 md:pt-54 lg:mb-26 lg:pt-54 text-center">
    <div aria-hidden="true" class="absolute inset-0 flex flex-col sm:hidden">
      <div class="relative w-full flex-1 bg-primary-800">
        <div class="absolute inset-0 overflow-hidden">
          {% if section.settings.background_video != blank %}
            <video autoplay muted loop playsinline preload="auto" class="absolute top-1/2 left-1/2 min-w-full min-h-full -translate-x-1/2 -translate-y-1/2 object-cover">
              <source src="{{ section.settings.background_video }}" type="video/mp4" />
            </video>
          {% elsif section.settings.background_image != blank %}
            {{ section.settings.background_image | image_url: width: 1920 | image_tag: class: 'absolute top-1/2 left-1/2 min-w-full min-h-full -translate-x-1/2 -translate-y-1/2 object-cover' }}
          {% else %}
            <video autoplay muted loop playsinline preload="auto" class="absolute top-1/2 left-1/2 min-w-full min-h-full -translate-x-1/2 -translate-y-1/2 object-cover">
              <source src="{{ hero_default_video }}" type="video/mp4" />
            </video>
          {% endif %}
        </div>
        <div class="absolute inset-0 bg-primary-800 opacity-70"></div>
      </div>
    </div>

    <div class="relative">
      {% if section.settings.eyebrow != blank %}
        <span class="text-lg font-oswald uppercase font-light tracking-normal text-white">{{ section.settings.eyebrow }}</span>
      {% endif %}
      {% if section.settings.heading != blank %}
        <h1 class="text-4xl font-oswald uppercase font-medium tracking-tight text-white sm:text-5xl md:text-6xl">{{ section.settings.heading }}</h1>
      {% endif %}
      {% if section.settings.subheading != blank %}
        <p class="mt-4 text-md sm:text-xl text-white">{{ section.settings.subheading }}</p>
      {% endif %}
      {% if section.settings.button_text != blank and hero_button_link != blank %}
        <div class="mt-4 sm:mt-6">
          <a href="{{ hero_button_link }}" class="inline-block rounded-md border border-transparent bg-secondary-600 px-8 py-3 font-medium text-white hover:bg-primary-400">{{ section.settings.button_text }}</a>
        </div>
      {% endif %}
    </div>
  </div>

  {% if section.blocks.size > 0 %}
    <section aria-labelledby="collection-heading" class="relative overflow-hidden -mt-40 sm:mt-0">
      <h2 id="collection-heading" class="sr-only">Collections</h2>
      <div class="max-w-400 mx-auto px-4">
        <div class="swiper" data-swiper data-swiper-config='{"slidesPerView":2,"spaceBetween":14,"loop":true,"navigation":{"nextEl":".btn-next","prevEl":".btn-prev"},"breakpoints":{"640":{"slidesPerView":3,"spaceBetween":20},"1024":{"slidesPerView":4,"spaceBetween":24}}}'>
          <div class="swiper-wrapper">
            {% for block in section.blocks %}
              <div class="swiper-slide" {{ block.shopify_attributes }}>
                <div class="collection-card">
                  <div class="collection-card-bg-wrap">
                    {% if block.type == 'collection' %}
                      {% assign collection = collections[block.settings.collection] %}
                      {% if block.settings.custom_image != blank %}
                        {{ block.settings.custom_image | image_url: width: 600 | image_tag: class: 'collection-card-bg', alt: collection.title }}
                      {% elsif collection.image != blank %}
                        {{ collection.image | image_url: width: 600 | image_tag: class: 'collection-card-bg', alt: collection.title }}
                      {% else %}
                        {{ 'collection-1' | placeholder_svg_tag: 'collection-card-bg' }}
                      {% endif %}
                    {% elsif block.type == 'custom_slide' %}
                      {% if block.settings.image != blank %}
                        {{ block.settings.image | image_url: width: 600 | image_tag: class: 'collection-card-bg', alt: block.settings.title }}
                      {% else %}
                        {{ 'collection-1' | placeholder_svg_tag: 'collection-card-bg' }}
                      {% endif %}
                    {% endif %}
                    <div class="collection-card-overlay"></div>
                  </div>
                  <div class="collection-card-content-wrap">
                    <div class="collection-card-content">
                      {% if block.settings.eyebrow != blank %}
                        <span class="collection-card-eyebrow">{{ block.settings.eyebrow }}</span>
                      {% endif %}
                      {% if block.type == 'collection' %}
                        {% assign collection = collections[block.settings.collection] %}
                        <h3 class="collection-card-title font-oswald">{{ collection.title }}</h3>
                      {% elsif block.type == 'custom_slide' %}
                        <h3 class="collection-card-title font-oswald">{{ block.settings.title }}</h3>
                      {% endif %}
                      <div class="collection-card-button-wrap">
                        {% if block.type == 'collection' %}
                          {% assign collection = collections[block.settings.collection] %}
                          <a href="{{ collection.url }}" class="collection-card-button">
                            View Products
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" width="20" height="20" class="size-5 md:size-6">
                              <path fill-rule="evenodd" d="M16.72 7.72a.75.75 0 0 1 1.06 0l3.75 3.75a.75.75 0 0 1 0 1.06l-3.75 3.75a.75.75 0 1 1-1.06-1.06l2.47-2.47H3a.75.75 0 0 1 0-1.5h16.19l-2.47-2.47a.75.75 0 0 1 0-1.06Z" clip-rule="evenodd" />
                            </svg>
                          </a>
                        {% elsif block.type == 'custom_slide' %}
                          {% if block.settings.link != blank %}
                            <a href="{{ block.settings.link }}" class="collection-card-button">
                              {{ block.settings.button_text | default: 'View Products' }}
                              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" width="20" height="20" class="size-5 md:size-6">
                                <path fill-rule="evenodd" d="M16.72 7.72a.75.75 0 0 1 1.06 0l3.75 3.75a.75.75 0 0 1 0 1.06l-3.75 3.75a.75.75 0 1 1-1.06-1.06l2.47-2.47H3a.75.75 0 0 1 0-1.5h16.19l-2.47-2.47a.75.75 0 0 1 0-1.06Z" clip-rule="evenodd" />
                              </svg>
                            </a>
                          {% endif %}
                        {% endif %}
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            {% endfor %}
          </div>
          <div class="swiper-hero-btn btn-prev">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" width="20" height="20" class="size-5">
              <path fill-rule="evenodd" d="M11.78 5.22a.75.75 0 0 1 0 1.06L8.06 10l3.72 3.72a.75.75 0 1 1-1.06 1.06l-4.25-4.25a.75.75 0 0 1 0-1.06l4.25-4.25a.75.75 0 0 1 1.06 0Z" clip-rule="evenodd" />
            </svg>
          </div>
          <div class="swiper-hero-btn btn-next">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" width="20" height="20" class="size-5">
              <path fill-rule="evenodd" d="M8.22 5.22a.75.75 0 0 1 1.06 0l4.25 4.25a.75.75 0 0 1 0 1.06l-4.25 4.25a.75.75 0 1 1-1.06-1.06L11.94 10 8.22 6.28a.75.75 0 0 1 0-1.06Z" clip-rule="evenodd" />
            </svg>
          </div>
        </div>
      </div>
    </section>
  {% endif %}
</div>


